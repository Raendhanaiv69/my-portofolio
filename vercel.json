{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1" 
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|svg|build)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "php /usr/local/bin/composer install --no-dev && npm install && npm run build",
  "outputDirectory": "public",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_DRIVER": "file",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "VIEW_COMPILED_PATH": "/tmp/views"
  }
}
